# Copy to .env.school.production on EC2. Replace placeholders.
# DO NOT commit .env.school.production.
#
# Path on EC2: /home/ec2-user/opt/school/.env.school.production
#
# Distinct from SugamFlow's .env.production on the same server:
#   SugamFlow:  /home/ec2-user/opt/sugamflow/.env.production
#   School:     /home/ec2-user/opt/school/.env.school.production
#
# Phase A start (default - core 9 services):
#   docker compose -f docker-compose.school.ec2-rds.yml --env-file .env.school.production up -d
#
# Phase B add-on:
#   COMPOSE_PROFILES=phase-b docker compose -f docker-compose.school.ec2-rds.yml --env-file .env.school.production up -d
#
# CRITICAL:
# - SECURITY_JWT_SECRET must match SugamFlow .env.production EXACTLY
# - Use FULL JDBC URLs (with your RDS hostname)
# - Use *_DB_USERNAME (not *_DB_USER)

SPRING_PROFILES_ACTIVE=prod

IMAGE_PREFIX=sumanthakur30
IMAGE_TAG=1.0.0

# Must match: docker network ls | grep sumanthakur30
SUGAMFLOW_DOCKER_NETWORK=sumanthakur30_default

# Leave empty for Phase A only. Uncomment to also start Phase B services.
# COMPOSE_PROFILES=phase-b

JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Kolkata -Xms96m -Xmx192m -XX:+ExitOnOutOfMemoryError
JVM_SERVICE_MEM_LIMIT=384m

# Hikari: max >= 3 for Flyway; min idle 0 to save RDS slots
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_POOL_IDLE_TIMEOUT_MS=120000
DB_POOL_MAX_LIFETIME_MS=600000
DB_POOL_CONNECTION_TIMEOUT_MS=30000

SECURITY_JWT_ENFORCE=true
SECURITY_JWT_SECRET=CHANGE_ME_SAME_AS_SUGAMFLOW_ENV_PRODUCTION_______
SECURITY_INVITE_INTERNAL_KEY=CHANGE_ME_SAME_AS_SUGAMFLOW_IF_USED_______
# Same value as SugamFlow SECURITY_INTERNAL_API_KEY (defaults to INVITE key if you leave them equal).
# Required so admission/fee/attendance can queue EMAIL when SECURITY_JWT_ENFORCE=true.
SECURITY_INTERNAL_API_KEY=CHANGE_ME_SAME_AS_SUGAMFLOW_INTERNAL_API_KEY_

# Docker DNS for platform notification-service (wired in docker-compose.school.ec2-rds.yml).
# Do not use localhost inside containers.
NOTIFICATION_SERVICE_URL=http://notification-service:8087

# Leave empty for Phase A only. For Website CMS + public HCP site also start:
#   COMPOSE_PROFILES=website
# Or Phase B ops modules:
#   COMPOSE_PROFILES=phase-b
# Or both:
#   COMPOSE_PROFILES=phase-b,website

# Replace YOUR_RDS_ENDPOINT, e.g. sugamflow-postgres.xxxxx.eu-north-1.rds.amazonaws.com

# ========== Phase A databases (required) ==========

SCHOOL_SETTINGS_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_settings_db?sslmode=require
SCHOOL_SETTINGS_DB_USERNAME=school_settings
SCHOOL_SETTINGS_DB_PASSWORD=CHANGE_ME

SCHOOL_SUBSCRIPTION_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_subscription_db?sslmode=require
SCHOOL_SUBSCRIPTION_DB_USERNAME=school_subscription
SCHOOL_SUBSCRIPTION_DB_PASSWORD=CHANGE_ME

SCHOOL_FORMS_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_forms_db?sslmode=require
SCHOOL_FORMS_DB_USERNAME=school_forms
SCHOOL_FORMS_DB_PASSWORD=CHANGE_ME

SCHOOL_WORKFLOW_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_workflow_db?sslmode=require
SCHOOL_WORKFLOW_DB_USERNAME=school_workflow
SCHOOL_WORKFLOW_DB_PASSWORD=CHANGE_ME

SCHOOL_ADMISSION_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_admission_db?sslmode=require
SCHOOL_ADMISSION_DB_USERNAME=school_admission
SCHOOL_ADMISSION_DB_PASSWORD=CHANGE_ME

SCHOOL_FEE_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_fee_db?sslmode=require
SCHOOL_FEE_DB_USERNAME=school_fee
SCHOOL_FEE_DB_PASSWORD=CHANGE_ME

SCHOOL_STUDENT_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_student_db?sslmode=require
SCHOOL_STUDENT_DB_USERNAME=school_student
SCHOOL_STUDENT_DB_PASSWORD=CHANGE_ME

SCHOOL_STAFF_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_staff_db?sslmode=require
SCHOOL_STAFF_DB_USERNAME=school_staff
SCHOOL_STAFF_DB_PASSWORD=CHANGE_ME

SCHOOL_ACADEMIC_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_academic_db?sslmode=require
SCHOOL_ACADEMIC_DB_USERNAME=school_academic
SCHOOL_ACADEMIC_DB_PASSWORD=CHANGE_ME

# ========== Phase B databases (COMPOSE_PROFILES=phase-b) ==========

SCHOOL_PAYROLL_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_payroll_db?sslmode=require
SCHOOL_PAYROLL_DB_USERNAME=school_payroll
SCHOOL_PAYROLL_DB_PASSWORD=CHANGE_ME

SCHOOL_ATTENDANCE_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_attendance_db?sslmode=require
SCHOOL_ATTENDANCE_DB_USERNAME=school_attendance
SCHOOL_ATTENDANCE_DB_PASSWORD=CHANGE_ME

SCHOOL_EXAM_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_exam_db?sslmode=require
SCHOOL_EXAM_DB_USERNAME=school_exam
SCHOOL_EXAM_DB_PASSWORD=CHANGE_ME

SCHOOL_LIBRARY_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_library_db?sslmode=require
SCHOOL_LIBRARY_DB_USERNAME=school_library
SCHOOL_LIBRARY_DB_PASSWORD=CHANGE_ME

SCHOOL_HOSTEL_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_hostel_db?sslmode=require
SCHOOL_HOSTEL_DB_USERNAME=school_hostel
SCHOOL_HOSTEL_DB_PASSWORD=CHANGE_ME

SCHOOL_TRANSPORT_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_transport_db?sslmode=require
SCHOOL_TRANSPORT_DB_USERNAME=school_transport
SCHOOL_TRANSPORT_DB_PASSWORD=CHANGE_ME

SCHOOL_NOTIF_CFG_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_notif_cfg_db?sslmode=require
SCHOOL_NOTIF_CFG_DB_USERNAME=school_notif_cfg
SCHOOL_NOTIF_CFG_DB_PASSWORD=CHANGE_ME

# ========== School Website Platform (website-service :8200, cms-service :8201) ==========
# Domains like hcpschool.com are NOT set here — map them in Super Admin → School Website Domains
# (shop-management-ui /admin/school-website-domains) + DNS/TLS at the edge.
#
# cdnBaseUrl on public resolve comes from WEBSITE_CDN_BASE_URL (CloudFront / CDN origin for media).
# Leave empty locally; set in prod when CDN exists. Restart website-service (and cms-service) after change.
#
# Code wiring:
#   services/website-service/.../application.properties  → website.cdn.base-url=${WEBSITE_CDN_BASE_URL:}
#   services/cms-service/.../application.properties      → cms.media.cdn-base-url=${CMS_MEDIA_CDN_BASE_URL:${WEBSITE_CDN_BASE_URL:}}
# Local jar start: set env before .\scripts\start-services.ps1, or export in the shell.
# EC2: this file at /home/ec2-user/opt/school/.env.school.production (when compose wires website/cms).

SCHOOL_WEBSITE_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_website_db?sslmode=require
SCHOOL_WEBSITE_DB_USERNAME=school_website
SCHOOL_WEBSITE_DB_PASSWORD=CHANGE_ME

SCHOOL_CMS_DB_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_cms_db?sslmode=require
SCHOOL_CMS_DB_USERNAME=school_cms
SCHOOL_CMS_DB_PASSWORD=CHANGE_ME

WEBSITE_CDN_BASE_URL=https://cdn.sugamflow.com
# Optional override for media only (defaults to WEBSITE_CDN_BASE_URL)
CMS_MEDIA_CDN_BASE_URL=https://cdn.sugamflow.com
CMS_MEDIA_S3_ENABLED=false
CMS_MEDIA_S3_BUCKET=
CMS_MEDIA_S3_REGION=ap-south-1
WEBSITE_DEFAULT_ERP_LOGIN_URL=https://school.sugamflow.com/login
