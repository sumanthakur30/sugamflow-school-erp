# Copy to .env.school.phase-a on EC2 (never commit real secrets).
# Use the SAME SECURITY_JWT_SECRET as SugamFlow .env.production.
#
# RDS host example:
#   jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/school_student_db?sslmode=require

SPRING_PROFILES_ACTIVE=prod
IMAGE_PREFIX=sumanthakur30
SCHOOL_IMAGE_TAG=1.0.0
IMAGE_TAG=1.0.0

# Must match docker compose project network for SugamFlow (name: sumanthakur30).
SUGAMFLOW_DOCKER_NETWORK=sumanthakur30_default

SECURITY_JWT_ENFORCE=true
SECURITY_JWT_SECRET=REPLACE_WITH_SAME_AS_SUGAMFLOW
SECURITY_INVITE_INTERNAL_KEY=REPLACE_WITH_SAME_AS_SUGAMFLOW

# Heap: Phase A = 7 JVMs × ~192m ≈ 1.3 GiB + mem_limit headroom
SCHOOL_JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Kolkata -Xms96m -Xmx192m -XX:+ExitOnOutOfMemoryError
SCHOOL_JVM_MEM_LIMIT=384m
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1

# --- Phase A databases (USERNAME not USER) ---
RDS_HOST=YOUR_RDS_ENDPOINT
RDS_OPTS=?sslmode=require

SCHOOL_SETTINGS_DB_URL=jdbc:postgresql://${RDS_HOST}:5432/school_settings_db${RDS_OPTS}
SCHOOL_SETTINGS_DB_USERNAME=school_settings
SCHOOL_SETTINGS_DB_PASSWORD=CHANGE_ME

SCHOOL_SUBSCRIPTION_DB_URL=jdbc:postgresql://${RDS_HOST}:5432/school_subscription_db${RDS_OPTS}
SCHOOL_SUBSCRIPTION_DB_USERNAME=school_subscription
SCHOOL_SUBSCRIPTION_DB_PASSWORD=CHANGE_ME

SCHOOL_ADMISSION_DB_URL=jdbc:postgresql://${RDS_HOST}:5432/school_admission_db${RDS_OPTS}
SCHOOL_ADMISSION_DB_USERNAME=school_admission
SCHOOL_ADMISSION_DB_PASSWORD=CHANGE_ME

SCHOOL_FEE_DB_URL=jdbc:postgresql://${RDS_HOST}:5432/school_fee_db${RDS_OPTS}
SCHOOL_FEE_DB_USERNAME=school_fee
SCHOOL_FEE_DB_PASSWORD=CHANGE_ME

SCHOOL_STUDENT_DB_URL=jdbc:postgresql://${RDS_HOST}:5432/school_student_db${RDS_OPTS}
SCHOOL_STUDENT_DB_USERNAME=school_student
SCHOOL_STUDENT_DB_PASSWORD=CHANGE_ME

SCHOOL_STAFF_DB_URL=jdbc:postgresql://${RDS_HOST}:5432/school_staff_db${RDS_OPTS}
SCHOOL_STAFF_DB_USERNAME=school_staff
SCHOOL_STAFF_DB_PASSWORD=CHANGE_ME

SCHOOL_ACADEMIC_DB_URL=jdbc:postgresql://${RDS_HOST}:5432/school_academic_db${RDS_OPTS}
SCHOOL_ACADEMIC_DB_USERNAME=school_academic
SCHOOL_ACADEMIC_DB_PASSWORD=CHANGE_ME
