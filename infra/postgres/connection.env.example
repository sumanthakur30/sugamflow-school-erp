# Shared with SugamFlow local Postgres (host install, not school Docker).
# Docs: D:/sugamflow/docs/LOCAL-POSTGRES.md

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_ADMIN_DB=postgres

# From Dockerized SugamFlow services, host is:
#   host.docker.internal:5432
# From school JVM / tools on Windows host:
#   localhost:5432

SCHOOL_SETTINGS_DB_URL=jdbc:postgresql://localhost:5432/school_settings_db
SCHOOL_SETTINGS_DB_USER=school_settings
SCHOOL_SETTINGS_DB_PASSWORD=school_settings

