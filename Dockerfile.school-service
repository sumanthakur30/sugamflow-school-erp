# Generic School domain service image (multi-module Maven reactor under services/).
# Build from D:\school repo root:
#   docker build -f Dockerfile.school-service --build-arg MODULE=student-service -t sumanthakur30/student-service:1.0.0 .

FROM maven:3.9-eclipse-temurin-17 AS build
ARG MODULE
WORKDIR /source
COPY services ./services
# Prefer the Spring Boot fat jar. Exclude thin/helper jars (*-original*, *-copy*, *-plain*).
# Using "sort | tail" previously picked subscription-service-copy.jar (~250KB) → "no main manifest attribute".
RUN mvn -f services/pom.xml -pl "${MODULE}" -am -DskipTests package \
 && JAR="$(find "services/${MODULE}/target" -maxdepth 1 -type f -name "${MODULE}-*.jar" \
      ! -name "*-original.jar" \
      ! -name "*-plain.jar" \
      ! -name "*-copy.jar" \
      ! -name "*sources.jar" \
      ! -name "*javadoc.jar" \
      -printf '%s\t%p\n' | sort -n | tail -n 1 | cut -f2-)" \
 && test -n "$JAR" \
 && echo "Packaging image with: $JAR ($(wc -c < "$JAR") bytes)" \
 && cp "$JAR" /tmp/app.jar

FROM eclipse-temurin:17-jre
WORKDIR /app
RUN useradd --system --uid 10001 school
COPY --from=build /tmp/app.jar /app/app.jar
USER school
# Actual listen port comes from SERVER_PORT / application.properties
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
